{
  "name": "felconca/phpstan-ui",
  "description": "A local UI for PHPStan analysis results",
  "type": "phpstan-extension",
  "require": {
    "php": ">=7.4",
    "phpstan/phpstan": "^1.11",
    "phpstan/extension-installer": "^1.3"
  },
  "autoload": {
    "psr-4": {
      "PhpstanUi\\": "src/"
    }
  },
  "extra": {
    "phpstan": {
      "includes": [
        "extension.neon"
      ]
    }
  },
  "config": {
    "allow-plugins": {
      "phpstan/extension-installer": true
    }
  }
}
